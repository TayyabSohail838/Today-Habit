# Copy this file to .env and fill in your real credentials.
# Find Supabase credentials at: https://app.supabase.com → your project → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─────────────────────────────────────────────────────────────────
# AI ASSISTANT (Gemini)
# ─────────────────────────────────────────────────────────────────
# Get your free Gemini API key at: https://aistudio.google.com/apikey
# Then add it here AND in Vercel: Project → Settings → Environment Variables
#
#   Name:  GEMINI_API_KEY
#   Value: your-gemini-api-key-here
#
# The key is SERVER-SIDE ONLY (used in api/chat.js, never exposed to the browser).
# Do NOT prefix it with VITE_ — that would expose it to clients.
GEMINI_API_KEY=your-gemini-api-key-here
